---
/**
 * Card preview — every {@link AnimeCard} state on one page.
 *
 * @module pages/card-preview
 * @remarks
 * Static harness for eyeballing the card without touching the database:
 * airing, finished, unrated and not-yet-aired rows side by side. Fixtures are
 * local to this page; production grids get their data from
 * {@link animeListService}.
 */
import '@styles/global.css'
import { AnimeCard } from '@anime/components'
import type { AnimeCard as AnimeCardData } from '@anime/types'

const mediaUrl = (malId: number, size: 'large' | 'small') =>
  `https://www.anidev.app/media/anime/${malId}/poster/${size}?source=myanimelist`

const buildSample = (
  malId: number,
  title: string,
  year: number,
  status: string,
  score: number | null
): AnimeCardData => ({
  malId,
  title,
  year,
  status,
  score,
  type: 'TV',
  imageUrl: mediaUrl(malId, 'large'),
  smallImageUrl: mediaUrl(malId, 'small'),
  altImageText: `Poster for ${title}`,
})

const samples: AnimeCardData[] = [
  buildSample(20, 'Naruto', 2002, 'Finished Airing', 8.5),
  buildSample(1, 'Cowboy Bebop', 1998, 'Finished Airing', 8.75),
  buildSample(21, 'One Piece', 1999, 'Currently Airing', 8.7),
  buildSample(52991, 'Frieren: Beyond Journey’s End', 2023, 'Finished Airing', 9),
  buildSample(57334, 'Dandadan', 2024, 'Currently Airing', 8.6),
  buildSample(6, 'Trigun Stampede', 2023, 'Finished Airing', null),
  buildSample(59978, 'Sentenced to Be a Hero', 2026, 'Not yet aired', null),
  buildSample(5, 'Fullmetal Alchemist: Brotherhood', 2009, 'Finished Airing', 9.1),
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Card preview</title>
  </head>
  <body class="bg-surface text-on-surface">
    <main class="min-h-screen px-4 py-12 md:px-40 md:py-16">
      <header class="border-border mb-10 flex flex-col gap-2 border-b pb-4">
        <div class="flex items-center gap-3">
          <span aria-hidden="true" class="bg-editorial-accent block h-px w-6"
          ></span>
          <h1
            class="font-heading text-editorial-accent text-sm font-bold tracking-[0.2em] uppercase"
          >
            Anime card · editorial system
          </h1>
        </div>
        <p
          class="font-heading text-on-surface-muted text-[11px] font-medium tracking-[0.18em] uppercase"
        >
          Airing · Finished · Unrated · Not yet aired
        </p>
      </header>
      <div
        class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4"
      >
        {samples.map((anime) => <AnimeCard anime={anime} />)}
      </div>
    </main>
  </body>
</html>
