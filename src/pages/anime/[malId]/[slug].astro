---
import { animeService } from '@anime/services/anime'
import { InfraError } from '@shared/errors/app-error'
import AnimeDetails from '@anime/components/anime-details/anime-details.astro'
import ServiceUnavailable from '@components/service-unavailable/service-unavailable.astro'
import Base from '@layouts/base-layout.astro'

const { malId } = Astro.params

if (!malId || isNaN(Number(malId))) {
  return Astro.redirect('/404')
}

let degraded = false
let animeDetails = null

try {
  const result = await animeService.getAnimeDetails(Number(malId))
  animeDetails = result.value
} catch (error) {
  if (error instanceof InfraError) {
    degraded = true
    Astro.response.status = 503
  } else {
    return Astro.redirect('/404')
  }
}

if (!degraded && !animeDetails) {
  return Astro.redirect('/404')
}
---

{
  degraded ? (
    <Base
      title="Service unavailable - AniDev"
      description="AniDev is temporarily unavailable. Please retry shortly."
      imageUrl=""
      url={Astro.url.pathname}
    >
      <ServiceUnavailable
        title="We could not load this anime right now"
        message="Something went wrong on our side. Please retry in a moment."
        retryHref={Astro.url.pathname}
      />
    </Base>
  ) : animeDetails ? (
    <Base
      title={`${animeDetails.title} - AniDev`}
      description={animeDetails.synopsis}
      imageUrl={animeDetails.imageUrl}
      url={animeDetails.url}
    >
      <AnimeDetails animeDetails={animeDetails} />
    </Base>
  ) : null
}