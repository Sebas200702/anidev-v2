---
/**
 * Carousel slide header: kicker, genres, logo, title, and facts row.
 *
 * @module domains/anime/components/anime-carousel/carousel-item-header
 * @remarks
 * Extracted from {@link CarouselItem} so the slide shell stays under the
 * file-size rule. Presentational only.
 */
import Picture from '@components/picture/picture.astro'
import { IconStar } from '@tabler/icons-react'
import type { CarouselItemProps as Props } from './types'

const { item } = Astro.props as Props
---

<header class="flex flex-col items-start gap-3">
  <div class="flex items-center gap-2">
    <div class="bg-editorial-accent h-px w-6"></div>
    <span
      class="text-editorial-accent font-heading text-sm font-bold tracking-[0.2em] uppercase"
    >
      Most Trending
    </span>
    <div class="bg-on-surface-muted h-1 w-1 rounded-full"></div>
    <span
      class="text-on-surface-muted font-heading text-xs font-bold uppercase"
    >
      N° {String(item.malId).slice(0, 2)}
    </span>
  </div>

  <ul
    class="font-heading flex flex-wrap gap-2 text-xs font-medium"
    aria-label="Anime genres"
  >
    {
      item.genres.map((genre) => (
        <li class="group relative cursor-pointer">
          <span class="border-border absolute right-0 size-1 border-b border-l" />
          <a
            href={genre.url}
            class="text-on-surface-muted hover:text-focus p-2 transition-colors"
          >
            #{genre.name}
          </a>
        </li>
      ))
    }
  </ul>
  <Picture
    imageUrl={item.clearLogo}
    smallImageUrl={item.clearLogo}
    alt={item.title}
    imageStyles="w-110"
    aspectRatio="440/165"
  />
  <h4 class="font-heading text-lg font-bold">{item.title}</h4>
  <div
    class="text-on-surface-muted font-heading flex flex-wrap items-center gap-3 text-xs font-semibold tracking-wider uppercase"
  >
    <span
      class="text-warning flex items-center gap-1 px-1"
      role="status"
      aria-label={`Score: ${item.score}`}
    >
      <IconStar className="w-3.5 h-3.5 text-warning" aria-hidden="true" />
      <span>{item.score.toFixed(1)}</span>
    </span>
    <span>·</span>
    <time datetime={String(item.year)}>{item.year}</time>
    <span>·</span>
    <span class="rounded px-2 py-0.5">TV</span>
  </div>
</header>
