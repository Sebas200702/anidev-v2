---
/**
 * CarouselItem — one featured-anime slide.
 *
 * @module domains/anime/components/anime-carousel/carousel-item
 * @remarks
 * Presentational shell: the banner sits behind three token-driven
 * {@link Overlay} scrims (top, bottom and a wide right-to-left wash) so the
 * copy stays readable over any artwork. Copy blocks live in
 * `carousel-item-header.astro` and `carousel-item-actions.astro`.
 *
 * @see {@link CarouselItemProps}
 * @see {@link animeCarouselService}
 */
import { Overlay } from '@components/overlay'
import Picture from '@components/picture/picture.astro'
import type { CarouselItemProps as Props } from './types'
import CarouselItemActions from './carousel-item-actions.astro'
import CarouselItemHeader from './carousel-item-header.astro'

const { item } = Astro.props as Props

const season = item.season.charAt(0).toUpperCase() + item.season.slice(1)
---

<section class="relative flex h-full w-full items-center overflow-hidden">
  <Overlay
    direction="up"
    viaColor="transparent"
    viaInterval="60%"
    fromColor="surface"
  />
  <Overlay
    direction="down"
    viaColor="transparent"
    viaInterval="60%"
    fromColor="surface"
  />
  <Overlay
    direction="right"
    viaColor="surface"
    viaInterval="35%"
    fromColor="surface"
  />

  <div class="pointer-events-none absolute inset-0 z-0 select-none">
    <Picture
      imageUrl={item.bannerImage}
      smallImageUrl={item.bannerImage}
      alt={`Banner image of ${item.title}`}
      imageStyles="w-full h-full object-cover object-center"
      isBanner
    />
  </div>

  <article
    class="relative z-10 flex h-full w-full flex-col justify-center px-4 py-8 md:px-40"
  >
    <div class="flex max-w-xl flex-col items-start gap-4 text-left">
      <CarouselItemHeader item={item} />

      <p
        class="text-on-surface-muted font-body line-clamp-3 text-sm leading-relaxed font-light text-pretty"
      >
        {item.description}
      </p>
      <div
        class="text-on-surface-muted relative z-0 flex w-full justify-between px-4 py-2 text-[10px]"
      >
        <span>ID - {item.malId}</span>
        <span>Season - {season}</span>
        <span class="border-border absolute right-0 bottom-0 size-3 border-r border-b"
        ></span>
        <span class="border-border absolute bottom-0 left-0 size-3 border-b border-l"
        ></span>
      </div>

      <CarouselItemActions item={item} />
    </div>
  </article>
</section>
