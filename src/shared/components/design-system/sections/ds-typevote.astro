---
/**
 * TEMPORARY type vote — delete after the heading decision.
 *
 * @module shared/components/design-system/sections/ds-typevote
 * @remarks
 * Renders the four heading candidates live over the Nunito Sans body so the
 * choice is made by eye, not by name. Remove this section plus the
 * `--font-candidate-*` tokens and the extra `AstroFont` entries once a
 * winner is picked.
 */
import SectionShell from '../section-shell.astro'

const specimens: ReadonlyArray<{
  index: string
  name: string
  note: string
  font: string
  sample: string
  accent?: string
}> = [
  {
    index: 'A',
    name: 'Fraunces',
    note: 'Serifada expresiva · regular-black + itálica',
    font: 'font-candidate-fraunces',
    sample: 'Libertad de exploración',
    accent: 'Tokyo 2042',
  },
  {
    index: 'B',
    name: 'Bricolage Grotesque',
    note: 'Grotesca francesa · 400–800',
    font: 'font-candidate-bricolage',
    sample: 'Libertad de exploración',
  },
  {
    index: 'C',
    name: 'Unbounded',
    note: 'Ancha futurista · 400–900',
    font: 'font-candidate-unbounded',
    sample: 'Libertad de exploración',
  },
  {
    index: 'D',
    name: 'Space Grotesk',
    note: 'Neogrotesca técnica · 400–700',
    font: 'font-candidate-space-grotesk',
    sample: 'Libertad de exploración',
  },
]
---

<SectionShell
  index="00"
  title="Type vote"
  blurb="TEMPORAL — cuatro candidatas sobre body Nunito Sans. Elige por ojo."
/>

<div class="flex flex-col gap-10">
  {
    specimens.map((spec) => (
      <article class="border-border-strong flex flex-col gap-4 rounded-editorial border-2 p-6 md:p-8">
        <div class="flex items-baseline justify-between gap-4">
          <p class="font-label text-focus text-[11px] tracking-[0.2em] uppercase">
            {spec.index} — {spec.name}
          </p>
          <p class="font-label text-on-surface-subtle hidden text-[11px] tracking-[0.2em] uppercase sm:block">
            {spec.note}
          </p>
        </div>
        <p class={`text-on-surface text-4xl leading-none font-black tracking-tight uppercase md:text-6xl ${spec.font}`}>
          {spec.sample}
        </p>
        {spec.accent && (
          <p class={`text-brand-300 text-2xl leading-none font-semibold italic md:text-4xl ${spec.font}`}>
            {spec.accent}
          </p>
        )}
        <p class="text-m text-on-surface-muted max-w-prose">
          AniDev es un catálogo de descubrimiento para explorar anime, música
          y contenido relacionado. Así convive el heading con el body Nunito
          Sans en un párrafo real.
        </p>
        <p class="font-label text-on-surface-subtle text-[11px] tracking-[0.18em] uppercase">
          Fig. {spec.index} — Get tickets · May 20–22 · 0123456789
        </p>
      </article>
    ))
  }
</div>
