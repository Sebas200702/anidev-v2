---
/**
 * Button variants: the five global pills plus four landing candidates.
 *
 * @module shared/components/design-system/sections/ds-buttons
 * @remarks
 * Private section of {@link DesignSystem}. Reuses the shared {@link Button}.
 * Pills stay untouched; candidates A–D compete below in the mono voice.
 */
import Button from '../../button/button.astro'
import SectionShell from '../section-shell.astro'
---

<SectionShell
  index="03"
  title="Buttons"
  blurb="Five global pills stay. Candidates A–D compete in mono below."
/>

<div class="flex flex-col gap-6">
  <div class="flex flex-col gap-2">
    <p class="font-label text-on-surface-subtle text-[11px] tracking-[0.2em] uppercase">
      Current / pills
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <Button title="Primary" variant="button-primary" />
      <Button title="Secondary" variant="button-secondary" />
      <Button title="Tertiary" variant="button-tertiary" />
      <Button title="Ghost" variant="button-ghost" />
      <Button title="Destructive" variant="button-destructive" />
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <p class="font-label text-on-surface-subtle text-[11px] tracking-[0.2em] uppercase">
      Candidates / mono
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <Button title="A · Terminal" variant="button-terminal" />
      <Button title="B · Hard" variant="button-hard" />
      <Button title="C · Rule" variant="button-rule" />
      <Button title="D · Manifesto" variant="button-manifesto" />
    </div>
  </div>
  <div class="flex flex-col gap-2">
    <p class="font-label text-on-surface-subtle text-[11px] tracking-[0.2em] uppercase">
      Hard family / B graduates
    </p>
    <div class="flex flex-wrap items-center gap-3">
      <Button title="Primary" variant="button-hard-primary" />
      <Button title="Secondary" variant="button-hard-secondary" />
      <Button title="Tertiary" variant="button-hard-tertiary" />
      <Button title="Ghost" variant="button-hard-ghost" />
      <Button title="Destructive" variant="button-hard-destructive" />
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <Button title="Disabled" variant="button-primary" disabled />
    <Button title="Loading" variant="button-secondary" isLoading />
  </div>
</div>
