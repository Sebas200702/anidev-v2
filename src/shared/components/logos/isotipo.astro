---
/**
 * Isotipo — the AniDev "A" mark.
 *
 * @module shared/components/logos/isotipo
 * @remarks
 * Inline SVG so it inherits the theme: the counter-form uses
 * `fill-brand-700` (the swappable accent) and the stem `fill-on-surface`,
 * so the mark re-themes with the tokens instead of shipping a fixed asset.
 *
 * @example
 * ```astro
 * <Isotipo className="w-12" />
 * ```
 */
interface Props {
  className?: string
}

const { className } = Astro.props as Props
