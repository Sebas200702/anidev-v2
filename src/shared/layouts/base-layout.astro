---
import { AstroFont } from 'astro-font'
import '@styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { Footer, Header } from '@components/index'
import { Toolbar } from '@components/toolbar'
import { META_CONTENT_SECURITY_POLICY } from '@middleware/security-headers'

interface Props {
  title: string
  imageUrl: string
  description: string
  url: string
  /** Keep the page out of search results (documentation surfaces). */
  noIndex?: boolean
}
const { title, imageUrl, description, url, noIndex = false } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="MMmywKMxZRfBscGxXQPHrZB_8q2Gre3c8Lb4VglQ3Lw"
    />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:image" name="og:image" content={imageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:site" content={url} />
    <meta
      http-equiv="Content-Security-Policy"
      content={META_CONTENT_SECURITY_POLICY}
    />

    <AstroFont
      config={[
        {
          src: [],
          name: 'Nunito Sans',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400..800&display=swap&',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Kode Mono',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400..700&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-heading, .font-display, .font-label',
          fallback: 'monospace',
        },
      ]}
    />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div id="modal-root"></div>
    <div
      id="app"
      class="bg-surface text-on-surface no-scrollbar max-w-dvw overflow-x-hidden overflow-y-scroll"
    >
      <Header />
      <Toolbar />
      <main
        id="layout-player-container"
        class="relative flex max-w-dvw flex-col [grid-area:main]"
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
