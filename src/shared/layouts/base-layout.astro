---
import { AstroFont } from 'astro-font'
import '@styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { Footer, Header } from '@components/index'
import { Toolbar } from '@components/toolbar'

interface Props {
  title: string
  imageUrl: string
  description: string
  url: string
  /** Keep the page out of search results (documentation surfaces). */
  noIndex?: boolean
}
const { title, imageUrl, description, url, noIndex = false } = Astro.props
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="16x16" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="google-site-verification"
      content="MMmywKMxZRfBscGxXQPHrZB_8q2Gre3c8Lb4VglQ3Lw"
    />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />
    <meta property="og:image" name="og:image" content={imageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:site" content={url} />
    <meta
      http-equiv="Content-Security-Policy"
      content="
    default-src 'self';
    connect-src 'self' data: blob: https://a.animethemes.moe https://v.animethemes.moe  https://i.ytimg.com https://o4510429009674240.ingest.us.sentry.io;
    script-src
      'self'
      'unsafe-inline'
      https://cdn.jsdelivr.net
      https://www.gstatic.com
      http://www.gstatic.com;
    frame-src 'self' https://www.youtube.com/ https://www.youtube-nocookie.com/;
    style-src 'self' 'unsafe-inline';
    media-src 'self' blob: https://a.animethemes.moe https://v.animethemes.moe;
    font-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com;
    img-src
      'self'
      data:
      blob:
      https://i.ytimg.com
      https://coffee-advanced-tern-335.mypinata.cloud
      https://pub-92474f7785774e91a790e086dfa6b2ef.r2.dev
      https://lh3.googleusercontent.com/
      https://anidev.app
      https://www.anidev.app
      https://www.youtube.com/;
    worker-src 'self' blob:;
  "
    />

    <AstroFont
      config={[
        {
          src: [],
          name: 'Nunito',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap&',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Nunito Sans',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400..800&display=swap&',
          preload: true,
          display: 'swap',
          selector: 'body',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Archivo',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-display',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Space Mono',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-label',
          fallback: 'monospace',
        },
        {
          src: [],
          name: 'Fraunces',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..700&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-candidate-fraunces',
          fallback: 'serif',
        },
        {
          src: [],
          name: 'Bricolage Grotesque',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-candidate-bricolage',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Unbounded',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Unbounded:wght@400..900&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-candidate-unbounded',
          fallback: 'sans-serif',
        },
        {
          src: [],
          name: 'Space Grotesk',
          googleFontsURL:
            'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400..700&display=swap&',
          preload: false,
          display: 'swap',
          selector: '.font-candidate-space-grotesk',
          fallback: 'sans-serif',
        },
      ]}
    />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div id="modal-root"></div>
    <div
      id="app"
      class="bg-surface text-on-surface no-scrollbar max-w-dvw overflow-x-hidden overflow-y-scroll"
    >
      <Header />
      <Toolbar />
      <main
        id="layout-player-container"
        class="relative flex max-w-dvw flex-col [grid-area:main]"
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
