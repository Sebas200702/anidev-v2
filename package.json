{
  "name": "anidev-v2",
  "type": "module",
  "version": "0.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "audit": "bash scripts/audit.sh",
    "auth:generate": "bunx @better-auth/cli@latest generate --config src/lib/auth/server.ts",
    "auth:migrate": "bunx @better-auth/cli@latest migrate --config src/lib/auth/server.ts",
    "build": "astro build",
    "check": "biome check .",
    "check:types": "astro check",
    "check:write": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:clone-prod": "bash scripts/db/clone-prod.sh",
    "db:seed:e2e": "tsx e2e/fixtures/seed-db.ts",
    "dev": "astro dev",
    "format": "biome format --write .",
    "format:astro": "prettier --write \"src/**/*.astro\"",
    "preview": "astro preview",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "release:first": "standard-version --first-release",
    "release:major": "standard-version --release-as major",
    "release:minor": "standard-version --release-as minor",
    "release:patch": "standard-version --release-as patch",
    "release:prerelease": "standard-version --prerelease",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "RUN_DB_TESTS=1 vitest run integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@astrojs/react": "7.0.1",
    "@sentry/astro": "10.43.0",
    "@sentry/node": "10.43.0",
    "@sentry/react": "10.43.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "4.2.1",
    "@types/react": "19.2.14",
    "astro": "7.3.8",
    "astro-font": "1.1.0",
    "better-auth": "1.6.33",
    "drizzle-orm": "0.45.4",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "pino": "10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "tailwind-animations": "1.0.1",
    "tailwindcss": "4.2.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.11.10",
    "@types/pino": "7.0.5",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "dotenv": "17.3.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.6.12",
    "standard-version": "9.5.0",
    "tsx": "4.21.0",
    "typescript": "6",
    "vitest": "4.1.12"
  }
}
