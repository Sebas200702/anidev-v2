{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Group non-major runtime updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["!better-auth", "!astro", "!drizzle-orm"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Sensitive upgrades need manual review (runtime switches, auth, ORM)",
      "matchPackageNames": ["better-auth", "astro", "@astrojs/*", "drizzle-orm", "drizzle-kit", "sharp"],
      "labels": ["needs-manual-qa"],
      "prBodyNotes": "Run the full gate plus e2e before merging (auth/ORM/adapter changes)."
    }
  ],
  "lockFileMaintenance": { "enabled": true },
  "prHourlyLimit": 2
}
