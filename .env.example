NODE_ENV=development

DATABASE_URL=postgres://user:password@localhost:5432/anidev
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=replace-with-at-least-32-characters
APP_BASE_URL=http://localhost:4321

# Google sign-in (optional): set both or neither. Authorized redirect URI in
# Google Cloud: ${APP_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for profile avatar/banner uploads (optional: set ALL of
# S3_ENDPOINT/S3_REGION/S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY/
# S3_PUBLIC_URL, or leave them all empty to disable uploads). Any
# S3-compatible backend works; two production routes are documented and
# neither is hard-coded:
#
#   Cloudflare R2 (managed, global CDN, 10 GB free tier):
#     S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#     S3_REGION=auto
#     S3_FORCE_PATH_STYLE=false
#
#   Self-hosted MinIO (no external dependency; you own disk, backups, TLS):
#     S3_ENDPOINT=https://s3.<your-domain>      # MinIO behind your reverse proxy
#     S3_REGION=us-east-1
#     S3_FORCE_PATH_STYLE=true                  # default
#
# Both serve uploads publicly from S3_PUBLIC_URL, so the bucket must allow
# anonymous reads (or sit behind a public custom domain). With MinIO you must
# expose it over HTTPS on its own domain.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Defaults to true (MinIO). Set to false for R2.
S3_FORCE_PATH_STYLE=

SENTRY_DSN=
# Public (client-exposed) Rustrak/Sentry DSN for browser-side error capture.
# Optional: browser SDK no-ops when unset. Mirror SENTRY_DSN in production.
PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
