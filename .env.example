NODE_ENV=development

DATABASE_URL=postgres://user:password@localhost:5432/anidev
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=replace-with-at-least-32-characters
APP_BASE_URL=http://localhost:4321

# Google sign-in (optional): set both or neither. Authorized redirect URI in
# Google Cloud: ${APP_BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage for profile avatar/banner uploads (optional: set ALL of
# S3_ENDPOINT/S3_BUCKET/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY/S3_PUBLIC_URL,
# or leave them all empty to disable uploads — env.ts rejects a partial set).
# Any S3-compatible backend works and nothing is hard-coded. The route used in
# production is MinIO; Cloudflare R2 stays documented as the migration path:
#
#   Self-hosted MinIO — PRODUCTION ROUTE (docker-compose.storage.yml, deployed
#   on the VPS; full steps in AGENTS.md "Production storage"):
#     S3_ENDPOINT=http://minio:9000              # server-side only: container DNS
#     S3_REGION=us-east-1
#     S3_FORCE_PATH_STYLE=true                   # default
#     S3_PUBLIC_URL=https://media.anidev.app/anidev-media   # browser-facing
#
#   Cloudflare R2 (managed, global CDN, 10 GB free tier — migration target;
#   changing the S3_* block is env-only, no code change):
#     S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#     S3_REGION=auto
#     S3_FORCE_PATH_STYLE=false
#
# The two URLs serve different callers: S3_ENDPOINT is only used by the server
# (so MinIO can keep its ports bound to 127.0.0.1 and be reached on the
# compose network), while S3_PUBLIC_URL is loaded by the browser and therefore
# needs a public HTTPS origin — publish it through the reverse proxy, as
# `https://media.anidev.app` above. In both cases the bucket must allow
# anonymous reads; `minio-init` configures that for MinIO.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Defaults to true (MinIO). Set to false for R2.
S3_FORCE_PATH_STYLE=

SENTRY_DSN=
# Public (client-exposed) Rustrak/Sentry DSN for browser-side error capture.
# Optional: browser SDK no-ops when unset. Mirror SENTRY_DSN in production.
PUBLIC_SENTRY_DSN=
LOG_LEVEL=info
