# Local isolated stack for AniDev v2 (development only).
#
# These credentials point at the local `docker compose` services and are separate
# from production (.env.example). Copy to `.env.local` and load per service via
# the local stack (see the "Local stack" section in README/AGENTS).
#
# Spin up the stack first:
#   docker compose up -d
#
# Then apply migrations against the local DB:
#   bun run db:migrate

NODE_ENV=development

DATABASE_URL=postgres://anidev:anidev@localhost:5432/anidev
REDIS_URL=redis://localhost:6379

BETTER_AUTH_SECRET=local-dev-only-replace-with-at-least-32-chars
APP_BASE_URL=http://localhost:4321

# Rustrak (Sentry-compatible) local DSN. Project id defaults to `1`. Create a
# project in the dashboard (http://localhost:3000, admin@example.com / admin),
# then use its real Client Key (<key>@<host>:8080/<project_id>).
SENTRY_DSN=http://e4600773d54141d8b8e8250fc480f168@localhost:8080/1
# Public DSN for browser-side capture (exposed to the page bundle). Same Rustrak
# instance as SENTRY_DSN; leave empty to skip client error reporting. The browser
# must be able to reach the DSN host (Rustrak needs CORS enabled for cross-origin).
PUBLIC_SENTRY_DSN=http://e4600773d54141d8b8e8250fc480f168@localhost:8080/1
LOG_LEVEL=debug

# Variables required by `docker compose` (see the "Local stack" section in
# AGENTS.md). When shelling out to Compose, export these (or place them in the
# project `.env`) so the stack starts without committing credentials.
POSTGRES_USER=anidev
POSTGRES_PASSWORD=anidev
POSTGRES_DB=anidev
RUSTRAK_SESSION_SECRET_KEY=667e0e851a0df3f47d1929a54638dc9bad8563606789bd10c4a7c091070db092
RUSTRAK_SUPERUSER=admin@example.com:admin
